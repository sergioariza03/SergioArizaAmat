<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mirrors defaultTextStyle() in MyCompose.kt so both UI modes render the same text -->
    <style name="Widget.Filmoteca.Text" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="ThemeOverlay.Filmoteca.AppBar"
        parent="ThemeOverlay.Material3.ActionBar" />

    <style name="Widget.Filmoteca.ActionMode" parent="Widget.Material3.ActionMode">
        <item name="background">@color/md_theme_primary</item>
        <item name="titleTextStyle">@style/TextAppearance.Filmoteca.ActionMode.Title</item>
    </style>

    <style name="TextAppearance.Filmoteca.ActionMode.Title"
        parent="TextAppearance.Material3.ActionBar.Title">
        <item name="android:textColor">@color/md_theme_onPrimary</item>
    </style>
</resources>
